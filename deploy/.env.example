# Másold .env néven (az init-env.sh megcsinálja és kitölti a titkokat).
# A .env-et SOHA ne töltsd fel GitHubra (a .gitignore kizárja).

# --- Tailscale -------------------------------------------------------------
# A tailnet domainje: Tailscale admin → DNS oldalon látod (pl. valami-nev.ts.net).
TAILNET=valami-nev.ts.net

# Auth key: Tailscale admin → Settings → Keys → Generate auth key.
# "Reusable" legyen (két konténer használja). Első indulás után törölhető innen.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# A két új gép neve a tailneten → https://<név>.<TAILNET>
STREMHU_HOSTNAME=stremhu-tb
AIOSTREAMS_HOSTNAME=aiostreams
TMDB_HOSTNAME=tmdb

# --- TMDB-addon -------------------------------------------------------------
# themoviedb.org → Beállítások → API → API-kulcs (v3)
TMDB_API_KEY=
# Opcionális: fanart.tv személyes API-kulcs (szebb logók)
FANART_API_KEY=

# --- StremHU ----------------------------------------------------------------
STREMHU_IMAGE=ghcr.io/hubbert0/stremhu-source:torbox
STREMHU_SESSION_SECRET=

# TorBox API-kulcs a seed-takarításhoz (TorBox → Settings → API).
# Ha üres, a takarítás nem fut.
TORBOX_API_KEY=
# true = próbaüzem: csak naplózza, mit törölne
TORBOX_CLEANUP_DRY_RUN=false

# --- AIOStreams -------------------------------------------------------------
# 64 karakteres hex. Első indulás után NE változtasd meg!
AIOSTREAMS_SECRET_KEY=
# Bejelentkezés a konfigurációs oldalra: felhasznalo:jelszo
AIOSTREAMS_AUTH=admin:
