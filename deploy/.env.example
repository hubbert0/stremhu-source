# Másold .env néven (az init-env.sh megcsinálja és kitölti a titkokat).
# A .env-et SOHA ne töltsd fel GitHubra (a .gitignore kizárja).

# --- Tailscale -------------------------------------------------------------
# A tailnet domainje: Tailscale admin → DNS oldalon látod (pl. valami-nev.ts.net).
TAILNET=valami-nev.ts.net

# Auth key: Tailscale admin → Settings → Keys → Generate auth key.
# "Reusable" legyen (több konténer használja). Első indulás után törölhető innen.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# A gépek neve a tailneten → https://<név>.<TAILNET>
STREMHU_HOSTNAME=stremhu-tb
AIOSTREAMS_HOSTNAME=aiostreams
TMDB_HOSTNAME=tmdb
LELIBRARY_HOSTNAME=lelibrary
FELIRAT_HOSTNAME=felirat

# --- TMDB-addon -------------------------------------------------------------
# themoviedb.org → Beállítások → API → API-kulcs (v3)
TMDB_API_KEY=
# Opcionális: fanart.tv személyes API-kulcs (szebb logók)
FANART_API_KEY=

# --- StremHU ----------------------------------------------------------------
STREMHU_IMAGE=ghcr.io/hubbert0/stremhu-source:torbox
STREMHU_SESSION_SECRET=

# TorBox API-kulcs a seed-takarításhoz (TorBox → Settings → API).
# Ha üres, a takarítás nem fut.
TORBOX_API_KEY=
# true = próbaüzem: csak naplózza, mit törölne
TORBOX_CLEANUP_DRY_RUN=false

# --- AIOStreams -------------------------------------------------------------
# 64 karakteres hex. Első indulás után NE változtasd meg!
AIOSTREAMS_SECRET_KEY=
# Bejelentkezés a konfigurációs oldalra: felhasznalo:jelszo
AIOSTREAMS_AUTH=admin:

# --- LeLibrary (TorBox-könyvtár a Stremióban) ------------------------------
# A titkokat az init-env / install.sh generálja. Első indítás után
# NE változtasd meg őket (a mentett beállítások és az adatbázis ezekhez kötődik).
LELIBRARY_CONFIG_SECRET=
LELIBRARY_SELFHOST_SECRET=
LELIBRARY_DB_PASSWORD=

# --- Állapotfigyelő értesítései (ntfy) -------------------------------------
# A telefonon az ntfy alkalmazásban erre a témára iratkozz fel. A nevet az
# init-env / install.sh generálja; titokként kezeld (aki ismeri, látja az értesítéseket).
NTFY_TOPIC=

# --- Szerverpult ------------------------------------------------------------
# Csak a tailnetről érhető el: https://<PULT_HOSTNAME>.<TAILNET>
# (webes terminál: ugyanez a cím :8443 porton). A jelszót az init-env generálja.
PULT_HOSTNAME=pult
PULT_USER=admin
PULT_PASSWORD=
# A repó helye a szerveren (az install.sh beállítja).
REPO_DIR=/root/stremhu-source

# --- Automatikus karbantartás (az install.sh cron-feladatként állítja be) ----
# Önjavító figyelő: 3 percenként kívülről ellenőrzi a nyilvános címeket, és ha
# egy kb. 10 percig nem válaszol, újraindítja (értesítéssel). 0 = kikapcsolva.
ONJAVITO=1
# Heti frissítés vasárnap hajnali 5-kor (a mentés után), értesítéssel.
# 0 = kikapcsolva (ilyenkor kézzel frissíts: sh install.sh).
AUTO_FRISSITES=1
